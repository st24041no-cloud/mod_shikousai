{
  "$schema": "https://example.invalid/festival-circle-extension.schema.json",
  "id": "jp.festival.offline-pos",
  "name": "オフラインレジ",
  "version": "1.0.0",
  "description": "通信断でも会計を継続し、復旧時に安全に売上と在庫を同期します。",
  "entry": "./src/index.js",
  "styles": ["./styles.css"],
  "serviceWorker": "./src/service-worker.js",
  "icon": "./assets/icon.svg",
  "permissions": ["sales:read", "sales:write", "inventory:read", "inventory:write", "products:read"],
  "navigation": {
    "section": "運営",
    "label": "オフラインレジ",
    "icon": "receipt",
    "route": "/extensions/offline-pos"
  },
  "settings": {
    "autoSync": true,
    "syncIntervalSeconds": 20,
    "lowStockThreshold": 5,
    "allowNegativeStock": false
  },
  "compatibility": { "api": ">=1.0.0" }
}
